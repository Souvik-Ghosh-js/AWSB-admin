# Attar World Sonar Bangla — admin panel environment
# Copy to .env.local (development) or .env.production (build), and fill in.

# The API this panel talks to. Must be the same API the storefront uses.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Where the admin panel itself is served from.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Public base URL for product images, so next/image can optimise them.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Renders the panel against fixture data when the API is not running.
# NEVER set this to true in production.
NEXT_PUBLIC_USE_MOCKS=false
